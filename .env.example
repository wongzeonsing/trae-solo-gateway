# 端口
PORT=19980
HOST=127.0.0.1

# 登录态（只读，勿提交）
TRAE_AUTH_FILE=./secrets/trae-auth.json

# 上游
TRAE_UPSTREAM=https://api5-normal.mchost.guru
TRAE_FUNCTION=chat_v3
TRAE_DEFAULT_MODEL=deepseek-v4.1-flash

# 版本号是新模型的闸门，别降
TRAE_IDE_VERSION=3.4.4
TRAE_IDE_VERSION_CODE=20260924

# 非空时 /v1/* 必须带 Bearer；对外暴露时必填
GATEWAY_KEY=

LOG_LEVEL=info
TRAE_TIMEOUT_MS=300000
# token 剩余寿命低于该毫秒数就自动续期（默认 30 分钟）
TRAE_REFRESH_SKEW_MS=1800000
